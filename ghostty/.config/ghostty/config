# Font
font-family = "Iosevka Nerd Font Mono"
font-size = 16
# No ligatures (matches wezterm harfbuzz_features calt=0).
font-feature = -calt

theme = gruber-wezterm
cursor-style = block
cursor-style-blink = false

# Disable all GTK notifications
app-notifications = no-clipboard-copy

# Tabs/splits are tmux's job - keep ghostty a plain fast surface.
window-decoration = none
gtk-tabs-location = hidden
# ~1 cell sides, none top/bottom (as in wezterm).
window-padding-x = 8
window-padding-y = 0

# Don't let ghostty eat keys tmux wants.
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+w=unbind

# Word deletion moves off ctrl+w, whose muscle memory keeps closing browser
# tabs. Same trick as the old wezterm config: ctrl+backspace sends the ^W byte,
# so zsh, readline and nvim insert mode all delete a word with no per-app
# config; ctrl+w itself is swallowed here so the habit dies. Nothing wants
# <C-w> - nvim moves between splits with ctrl+hjkl (plugins/tmux.lua).
keybind = ctrl+backspace=text:\x17
keybind = ctrl+w=ignore

# Scrollback lives in tmux; keep ghostty's small.
scrollback-limit = 10000

confirm-close-surface = false

# Alt+Q lands inside tmux, which owns tabs, splits and scrollback.
# Every plain window attaches to the same "main" session, so they mirror
# each other; for an independent one use: ghostty -e tmux new-session -A -s <name>
command = tmux new-session -A -s main
