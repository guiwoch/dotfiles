# Font
font-family = "JetBrainsMono Nerd Font"
font-size = 14

theme = TokyoNight

# Disable all GTK notifications
app-notifications = no-clipboard-copy

# Tabs/splits are tmux's job - keep ghostty a plain fast surface.
window-decoration = none
gtk-tabs-location = hidden
window-padding-x = 6
window-padding-y = 4

# Don't let ghostty eat keys tmux wants.
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+w=unbind

# Scrollback lives in tmux; keep ghostty's small.
scrollback-limit = 10000

confirm-close-surface = false
