# Start from the system's en_US.UTF-8 compose table
include "%L"

# Portuguese: apostrophe (dead_acute) + c should give cedilla, not c-acute.
# These come after the include, so they override the defaults above.
<dead_acute> <c> : "ç" ccedilla
<dead_acute> <C> : "Ç" Ccedilla
<dead_acute> <space> : "'" apostrophe

# Apostrophe + any non-Portuguese letter types the pair literally (e.g. 's, not ś).
<dead_acute> <b> : "'b"
<dead_acute> <B> : "'B"
<dead_acute> <d> : "'d"
<dead_acute> <D> : "'D"
<dead_acute> <f> : "'f"
<dead_acute> <F> : "'F"
<dead_acute> <g> : "'g"
<dead_acute> <G> : "'G"
<dead_acute> <h> : "'h"
<dead_acute> <H> : "'H"
<dead_acute> <j> : "'j"
<dead_acute> <J> : "'J"
<dead_acute> <k> : "'k"
<dead_acute> <K> : "'K"
<dead_acute> <l> : "'l"
<dead_acute> <L> : "'L"
<dead_acute> <m> : "'m"
<dead_acute> <M> : "'M"
<dead_acute> <n> : "'n"
<dead_acute> <N> : "'N"
<dead_acute> <p> : "'p"
<dead_acute> <P> : "'P"
<dead_acute> <q> : "'q"
<dead_acute> <Q> : "'Q"
<dead_acute> <r> : "'r"
<dead_acute> <R> : "'R"
<dead_acute> <s> : "'s"
<dead_acute> <S> : "'S"
<dead_acute> <t> : "'t"
<dead_acute> <T> : "'T"
<dead_acute> <v> : "'v"
<dead_acute> <V> : "'V"
<dead_acute> <w> : "'w"
<dead_acute> <W> : "'W"
<dead_acute> <x> : "'x"
<dead_acute> <X> : "'X"
<dead_acute> <y> : "'y"
<dead_acute> <Y> : "'Y"
<dead_acute> <z> : "'z"
<dead_acute> <Z> : "'Z"
