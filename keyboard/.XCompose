# Punctuation and the dead keys themselves. Without these the dead key simply
# swallows the next keypress and waits, so "~-" produced nothing at all. Same
# rule as everywhere above: not a Portuguese accent, so type the pair.
<dead_acute> <minus> : "'-"
<dead_acute> <equal> : "'="
<dead_acute> <bracketleft> : "'["
<dead_acute> <bracketright> : "']"
<dead_acute> <backslash> : "'\\"
<dead_acute> <semicolon> : "';"
<dead_acute> <comma> : "',"
<dead_acute> <period> : "'."
<dead_acute> <slash> : "'/"
<dead_acute> <exclam> : "'!"
<dead_acute> <at> : "'@"
<dead_acute> <numbersign> : "'#"
<dead_acute> <dollar> : "'$"
<dead_acute> <percent> : "'%"
<dead_acute> <ampersand> : "'&"
<dead_acute> <asterisk> : "'*"
<dead_acute> <parenleft> : "'("
<dead_acute> <parenright> : "')"
<dead_acute> <underscore> : "'_"
<dead_acute> <plus> : "'+"
<dead_acute> <braceleft> : "'{"
<dead_acute> <braceright> : "'}"
<dead_acute> <bar> : "'|"
<dead_acute> <colon> : "':"
<dead_acute> <less> : "'<"
<dead_acute> <greater> : "'>"
<dead_acute> <question> : "'?"
<dead_acute> <quotedbl> : "'\""
<dead_acute> <apostrophe> : "''"
