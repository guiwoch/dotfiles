# Digits, same reasoning. dead_circumflex is deliberately absent here: the
# system table maps it to superscripts (m², m³), which Portuguese does use.
<dead_acute> <0> : "'0"
<dead_acute> <1> : "'1"
<dead_acute> <2> : "'2"
<dead_acute> <3> : "'3"
<dead_acute> <4> : "'4"
