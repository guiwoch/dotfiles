# =========================
# Secrets — never commit
# =========================
# Belt-and-braces: these should not live in this repo at all, but if a config
# dir is ever stowed wholesale, these patterns keep credentials out.
**/hosts.yml
**/rclone.conf
**/*token*
**/*secret*
**/*credential*
**/*.pem
**/*.key
**/id_rsa*
**/id_ed25519*
**/.netrc
**/.npmrc
**/*cookie*

# =========================
# Runtime / stateful files
# =========================

# clipse runtime data (history can contain passwords — keep it out of the repo)
clipse/**/clipboard_history.json
clipse/**/clipse.log
clipse/**/tmp_files/

# hyprland runtime / backups
hypr/**/hyprland.conf.save*
hypr/**/*.bak-*
hypr/**/hyprland.old
hypr/**/wallpaper.old
hypr/**/kb_layout_state

# herdr runtime (sockets, logs, session state, installed plugins) and the
# timestamped config backups its edits leave behind
herdr/**/*.sock
herdr/**/*.log
herdr/**/session.json
herdr/**/plugins/
herdr/**/plugins.json
herdr/**/.plugins.lock
herdr/**/config.toml.bak*

# kitty backups
kitty/**/*.bak

# neovim generated files
nvim-lazy/**/lazy-lock.json
nvim-lazy/**/lazyvim.json

# generated package lists (drift out of date fast; run scripts/sync-pkglist.sh)
pkglist-repo.txt
pkglist-aur.txt

# =========================
# Tooling / local overrides
# =========================
# Per-repo Claude Code state: a .claude/ that appears *inside* a package (or at
# the root of this repo) is scratch for whatever project lives there, never
# config anyone else should get. settings.local.json is machine-local by
# definition - it holds the permissions this machine happened to approve.
**/.claude/settings.local.json
**/.claude/

# ...with one exception: claude/ is a stow package, so its payload has to be
# literally named .claude to land at ~/.claude. Re-include the directory first -
# git cannot re-include a file whose parent directory is excluded - and then
# only settings.json. Everything else under ~/.claude is state, not config:
# .credentials.json, 90M of projects/ (transcripts *and* auto-memory), caches,
# daemon and session files, plus plugins/ and skills/synced/ which are refetched
# from their marketplaces. hooks/herdr-agent-state.sh is deliberately absent
# too: herdr writes it, versioned to the herdr that wrote it, and
# `herdr integration install claude` regenerates it on a new machine.
!claude/.claude/
!claude/.claude/settings.json

# =========================
# Editor / OS junk
# =========================
*.swp
*.swo
*~
.DS_Store
